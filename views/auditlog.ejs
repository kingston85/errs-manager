<div class="card" style="padding:0;">
  <% if (!rows.length) { %>
    <div class="empty-state">No activity recorded yet.</div>
  <% } else { %>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
        <tbody>
          <% rows.forEach((r) => { %>
            <tr>
              <td class="text-sm text-muted" style="white-space:nowrap;"><%= new Date(r.created_at).toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></td>
              <td><%= r.user_name || '<span class="text-muted">System</span>' %></td>
              <td><span class="badge badge-slate"><%= r.action %></span></td>
              <td class="text-sm"><%= r.entity_type %><%= r.entity_id ? ' #' + r.entity_id : '' %></td>
              <td class="text-sm text-muted"><%= r.details || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
