<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title ? title + ' — ERRS Manager' : 'ERRS Manager' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="toast-stack">
      <div class="toast <%= flash.type === 'error' ? 'toast-error' : '' %>">
        <span class="toast-icon"><%= flash.type === 'error' ? '⚠️' : '✓' %></span>
        <span class="toast-message"><%= flash.message %></span>
        <button type="button" class="toast-close" aria-label="Dismiss">✕</button>
      </div>
    </div>
  <% } %>
  <div class="app-shell">
    <%- include('partials/sidebar') %>
    <div class="main">
      <div class="topbar">
        <h1><%= title %></h1>
        <form class="global-search" action="/app/search" method="GET">
          <input type="search" name="q" placeholder="Search everything…" value="<%= typeof q !== 'undefined' && currentPath === '/app/search' ? q : '' %>" aria-label="Search">
          <button type="submit" aria-label="Search">🔍</button>
        </form>
        <% if (typeof notifications !== 'undefined') { %>
          <details class="notif-bell">
            <summary>
              🔔
              <% if (notifications.count > 0) { %><span class="notif-count"><%= notifications.count %></span><% } %>
            </summary>
            <div class="notif-panel">
              <div class="notif-panel-header">Due within 7 days</div>
              <% if (!notifications.items.length) { %>
                <div class="notif-empty">Nothing due soon.</div>
              <% } else { %>
                <% notifications.items.forEach((n) => { %>
                  <a class="notif-item" href="/app/reminders/<%= n.id %>/edit">
                    <span class="notif-item-subject"><%= n.subject %><% if (n.company_name) { %> — <%= n.company_name %><% } %></span>
                    <span class="notif-item-due <%= n.overdue ? 'notif-overdue' : '' %>"><%= new Date(n.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                  </a>
                <% }) %>
                <% if (notifications.overflow) { %><a class="notif-more" href="/app/reminders">View all reminders →</a><% } %>
              <% } %>
            </div>
          </details>
        <% } %>
      </div>
      <div class="content">
        <%- body %>
      </div>
    </div>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
