<div class="toolbar">
  <div></div>
  <a class="btn btn-secondary" href="/app/<%= entityKey %>">← Back to <%= entity.label %></a>
</div>

<div class="card" style="max-width:640px;">
  <h2 class="mt-0">Import <%= entity.label %> from CSV</h2>
  <p class="text-sm text-muted">
    The first row must be column headers. A column is matched by name — the easiest way to get this right is to
    <a href="/app/<%= entityKey %>/export.csv">export the current list</a> first and edit that file, or use these column names:
  </p>
  <ul class="text-sm text-muted">
    <% expectedColumns.forEach((c) => { %><li><%= c %></li><% }) %>
  </ul>
  <p class="text-sm text-muted">Rows whose name already exists are skipped — this is safe to run more than once against the same file.</p>

  <% if (result && result.error) { %>
    <div class="login-error"><%= result.error %></div>
  <% } %>
  <% if (result && !result.error) { %>
    <div class="card" style="background:var(--brand-light); border-color:var(--brand); margin-bottom:16px;">
      <strong><%= result.created %></strong> of <%= result.total %> rows imported.
      <% if (result.skipped) { %> <%= result.skipped %> skipped (already existed, or an empty row).<% } %>
      <% if (result.errors && result.errors.length) { %>
        <div style="margin-top:8px;">
          <strong>Errors:</strong>
          <ul class="text-sm">
            <% result.errors.forEach((e) => { %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>
    </div>
  <% } %>

  <!--
    A hidden _csrf field alone doesn't work here: this is a multipart form,
    and the CSRF check runs before multer parses that body (see
    src/lib/csrf.js), so the token has to travel in the query string instead.
  -->
  <form action="/app/<%= entityKey %>/import?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data">
    <div class="import-drop">
      <div>📄 Choose a CSV file</div>
      <input type="file" name="file" accept=".csv,text/csv" required>
    </div>
    <div class="flex gap-2" style="margin-top:14px;">
      <button class="btn btn-primary" type="submit">Import</button>
    </div>
  </form>
</div>
