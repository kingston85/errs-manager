DATABASE_URL="postgresql://errs_app:errs_dev_pw@localhost:5432/errs_db"
SESSION_SECRET="change-me-to-a-long-random-string"
PORT=3000
NODE_ENV=development

# --- Optional: email reminders (src/routes/internal.js) ---------------------
# Without these set, the "send due reminders" endpoint just logs what it
# would have sent instead of actually emailing anyone — safe to leave unset.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ERRS Manager <no-reply@example.com>"

# Shared secret an external scheduler must send as ?token=... to trigger
# GET /internal/send-due-reminders. Required for that route to do anything;
# generate with `openssl rand -hex 32`.
# INTERNAL_TASK_TOKEN=
