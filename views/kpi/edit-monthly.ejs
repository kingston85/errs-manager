<div class="card" style="max-width:640px; margin-bottom:16px;">
  <div class="text-sm text-muted">Deliverable</div>
  <h2 class="mt-0" style="margin-bottom:2px;"><%= deliverable.label %></h2>
  <div class="text-sm text-muted"><%= deliverable.unit_name || 'Department-wide' %> · <%= deliverable.year %> · Target: <%= deliverable.annual_target %><%= deliverable.target_unit ? ' ' + deliverable.target_unit : '' %></div>
</div>

<form action="/app/kpi/<%= deliverable.id %>/monthly" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card" style="max-width:640px;">
    <div class="grid grid-4">
      <% MONTHS.forEach((m, i) => { const n = i + 1; %>
        <div class="form-row">
          <label for="m<%= n %>"><%= m %></label>
          <input class="form-input" type="number" step="any" id="m<%= n %>" name="m<%= n %>" value="<%= monthly[n] !== undefined ? monthly[n] : '' %>">
        </div>
      <% }) %>
    </div>

    <div class="flex gap-2" style="margin-top:6px;">
      <button class="btn btn-primary" type="submit">Save Monthly Values</button>
      <a class="btn btn-secondary" href="/app/kpi?year=<%= deliverable.year %>">Cancel</a>
    </div>
  </div>
</form>
