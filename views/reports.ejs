<%
  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const withQuery = (params) => {
    const usp = new URLSearchParams({ year, month, ...params });
    return `/app/reports?${usp.toString()}`;
  };
  const exportUrl = () => `/app/reports/export.csv?year=${year}&month=${month}`;
  const years = [];
  for (let y = new Date().getFullYear(); y >= new Date().getFullYear() - 3; y--) years.push(y);
%>

<div class="toolbar">
  <form method="GET" class="filters">
    <select name="month" onchange="this.form.submit()">
      <% MONTHS.forEach((m, i) => { %><option value="<%= i + 1 %>" <%= month === i + 1 ? 'selected' : '' %>><%= m %></option><% }) %>
    </select>
    <select name="year" onchange="this.form.submit()">
      <% years.forEach((y) => { %><option value="<%= y %>" <%= year === y ? 'selected' : '' %>><%= y %></option><% }) %>
    </select>
  </form>
  <a class="btn btn-secondary" href="<%= exportUrl() %>">⬇ Export CSV</a>
</div>

<div class="card" style="padding:0; margin-bottom:20px;">
  <div style="overflow-x:auto;">
    <table class="data-table">
      <thead>
        <tr>
          <th>Unit</th><th>Cases Opened</th><th>Cases Issued</th>
          <th>Complaints Received</th><th>Complaints Closed</th>
          <th>Reminders Due</th><th>Still Scheduled</th>
        </tr>
      </thead>
      <tbody>
        <% units.forEach((u) => { %>
          <tr>
            <td><%= u.unit_name %></td>
            <td><%= u.cases_opened %></td>
            <td><%= u.cases_issued %></td>
            <td><%= u.complaints_received %></td>
            <td><%= u.complaints_closed %></td>
            <td><%= u.reminders_due %></td>
            <td><% if (u.reminders_still_scheduled > 0) { %><span class="badge badge-amber"><%= u.reminders_still_scheduled %></span><% } else { %><%= u.reminders_still_scheduled %><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2 class="mt-0">KPI Progress Through <%= MONTHS[month - 1] %> <%= year %></h2>
  <% if (!kpis.length) { %>
    <div class="empty-state"><div class="icon">🎯</div>No deliverables tracked for <%= year %>.</div>
  <% } else { %>
    <% kpis.forEach((k) => { const pct = k.annual_target ? Math.min(100, Math.round((k.cumulative / k.annual_target) * 100)) : 0; %>
      <div style="margin-bottom:14px;">
        <div class="flex justify-between text-sm" style="margin-bottom:4px;">
          <span><%= k.unit_name || 'Department-wide' %> — <%= k.label %></span>
          <span class="text-muted"><%= k.cumulative %> / <%= k.annual_target %><%= k.target_unit ? ' ' + k.target_unit : '' %> (<%= pct %>%)</span>
        </div>
        <div class="progress-bar"><div style="width: <%= pct %>%;"></div></div>
      </div>
    <% }) %>
  <% } %>
</div>
