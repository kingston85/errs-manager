<%
  // Shared by views/generic/form.ejs and views/documents/form.ejs — expects
  // `attachments` (rows from src/lib/attachmentsDb.js) and `attachmentsBase`
  // (e.g. /app/companies/14/attachments) in scope. Only rendered when
  // !isNew, since a record needs an id before anything can attach to it.
  const fmtSize = (n) => n < 1024 * 1024 ? `${Math.round(n / 1024)} KB` : `${(n / (1024 * 1024)).toFixed(1)} MB`;
  const fmtWhen = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  const fileIcon = (mime) => mime === 'application/pdf' ? '📄' : '🖼️';
%>
<div class="card" style="margin-top:16px;">
  <h2 class="mt-0">Attachments</h2>

  <% if (!attachments.length) { %>
    <div class="empty-state" style="padding:20px;"><div class="icon">📎</div>No files attached yet.</div>
  <% } else { %>
    <ul class="attachment-list">
      <% attachments.forEach((a) => { %>
        <li>
          <a href="<%= attachmentsBase %>/<%= a.id %>" target="_blank" class="attachment-link">
            <span class="attachment-icon"><%= fileIcon(a.mime_type) %></span>
            <span class="attachment-name"><%= a.filename %></span>
          </a>
          <span class="text-sm text-muted"><%= fmtSize(a.size_bytes) %> · <%= fmtWhen(a.created_at) %><% if (a.uploaded_by_name) { %> · <%= a.uploaded_by_name %><% } %></span>
          <% if (user.role !== 'INTERN') { %>
            <form action="<%= attachmentsBase %>/<%= a.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Remove this attachment? This cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-danger btn-sm" type="submit">Remove</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <!--
    Multipart form — the CSRF token has to travel as a query param, not a
    hidden field, since the check runs before multer parses this body.
    See src/lib/csrf.js.
  -->
  <form action="<%= attachmentsBase %>?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data" class="attachment-upload">
    <label for="attachment_file">Add a file</label>
    <input type="file" id="attachment_file" name="file" accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif" required>
    <div class="help">Upload a scanned document from your computer, or — on a phone or tablet — choose "Take Photo" to use the camera as a scanner. PDF, JPEG, PNG, WEBP, or HEIC, up to 8 MB.</div>
    <button class="btn btn-secondary btn-sm" type="submit" style="margin-top:8px;">Upload</button>
  </form>
</div>
