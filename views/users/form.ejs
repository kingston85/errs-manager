<% const dateVal = (v) => { if (!v) return ''; const d = (v instanceof Date) ? v : new Date(v); return isNaN(d) ? '' : d.toISOString().slice(0, 10); }; %>

<form action="<%= isNew ? '/app/users' : '/app/users/' + record.id %>" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card" style="max-width:520px;">
    <% if (error) { %><div class="login-error"><%= error %></div><% } %>

    <div class="form-row">
      <label for="name">Full Name *</label>
      <input class="form-input" type="text" id="name" name="name" value="<%= record.name || '' %>" required>
    </div>

    <% if (isNew) { %>
      <div class="form-row">
        <label for="username">Username *</label>
        <input class="form-input" type="text" id="username" name="username" value="<%= record.username || '' %>" required>
      </div>
    <% } else { %>
      <div class="form-row">
        <label>Username</label>
        <div class="text-muted"><%= record.username %></div>
      </div>
    <% } %>

    <div class="form-row">
      <label for="email">Email</label>
      <input class="form-input" type="email" id="email" name="email" value="<%= record.email || '' %>">
    </div>

    <div class="form-row">
      <label for="password">Password <%= isNew ? '*' : '' %></label>
      <input class="form-input" type="password" id="password" name="password" <%= isNew ? 'required' : '' %>>
      <% if (!isNew) { %><div class="help">Leave blank to keep the current password.</div><% } %>
    </div>

    <div class="form-row">
      <label for="role">Role *</label>
      <select class="form-select" id="role" name="role" required onchange="toggleRoleFields()">
        <option value="DEPT_HEAD" <%= record.role === 'DEPT_HEAD' ? 'selected' : '' %>>Department Head</option>
        <option value="UNIT_HEAD" <%= record.role === 'UNIT_HEAD' ? 'selected' : '' %>>Unit Head</option>
        <option value="STAFF" <%= record.role === 'STAFF' ? 'selected' : '' %>>Staff</option>
        <option value="INTERN" <%= record.role === 'INTERN' ? 'selected' : '' %>>Intern</option>
      </select>
    </div>

    <div class="form-row" id="row-unit">
      <label for="unit_id">Unit</label>
      <select class="form-select" id="unit_id" name="unit_id">
        <option value="">— None —</option>
        <% units.forEach((u) => { %>
          <option value="<%= u.id %>" <%= String(record.unit_id) === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-row" id="row-intern">
      <label for="intern_ends_at">Intern Access Ends</label>
      <input class="form-input" type="date" id="intern_ends_at" name="intern_ends_at" value="<%= dateVal(record.intern_ends_at) %>">
      <div class="help">After this date, this account is automatically signed out and blocked from logging in again.</div>
    </div>

    <% if (!isNew) { %>
      <div class="form-row">
        <label style="display:flex; align-items:center; gap:8px; font-weight:400;">
          <input type="checkbox" name="active" <%= record.active !== false ? 'checked' : '' %> style="width:auto;">
          Account is active
        </label>
      </div>
    <% } %>

    <div class="flex gap-2" style="margin-top:6px;">
      <button class="btn btn-primary" type="submit"><%= isNew ? 'Create Account' : 'Save Changes' %></button>
      <a class="btn btn-secondary" href="/app/users">Cancel</a>
    </div>
  </div>
</form>

<script>
  function toggleRoleFields() {
    const role = document.getElementById('role').value;
    document.getElementById('row-unit').style.display = role === 'DEPT_HEAD' ? 'none' : '';
    document.getElementById('row-intern').style.display = role === 'INTERN' ? '' : 'none';
  }
  toggleRoleFields();
</script>
