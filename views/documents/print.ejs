<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= record.document_number %> — ERRS Manager</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="no-print" style="max-width:720px; margin:16px auto 0; display:flex; justify-content:space-between;">
    <a class="btn btn-secondary" href="/app/documents">← Back to Licenses &amp; Certificates</a>
    <button class="btn btn-primary" onclick="window.print()">🖨 Print</button>
  </div>

  <div class="print-doc">
    <div class="print-header">
      <div>
        <h1>Environmental Protection Agency — Liberia</h1>
        <div class="agency">Environmental Research &amp; Radiation Safety Department · <%= record.unit_name %></div>
      </div>
      <div>
        <div class="text-sm text-muted" style="text-align:right;"><%= record.type_kind %></div>
        <div class="doc-number"><%= record.document_number %></div>
      </div>
    </div>

    <h2 class="mt-0" style="font-size:16px;"><%= record.type_label %></h2>

    <dl class="print-fields">
      <dt>Issued To</dt><dd><%= record.company_name %></dd>
      <% if (record.county || record.community || record.street_address) { %>
        <dt>Address</dt><dd><%= [record.street_address, record.community, record.county].filter(Boolean).join(', ') %></dd>
      <% } %>
      <% if (record.chemical_name) { %><dt>Chemical / Substance</dt><dd><%= record.chemical_name %></dd><% } %>
      <% if (record.activity) { %><dt>Activity</dt><dd><%= record.activity %></dd><% } %>
      <% if (record.quantity) { %><dt>Quantity</dt><dd><%= record.quantity %> <%= record.quantity_unit || '' %></dd><% } %>
      <dt>Date Issued</dt><dd><%= new Date(record.date_issued).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></dd>
      <% if (record.expiry_date) { %>
        <dt>Valid Until</dt><dd><%= new Date(record.expiry_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></dd>
      <% } %>
      <% if (record.reference_code) { %><dt>Reference Code</dt><dd><%= record.reference_code %></dd><% } %>
    </dl>

    <div class="print-footer">
      This document was generated by ERRS Manager and reflects the departmental record as of the print date. Document number <%= record.document_number %> is unique and sequentially allocated per document type per year.
    </div>
  </div>
</body>
</html>
