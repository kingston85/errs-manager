<%
  const humanize = (s) => String(s).replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';
%>

<div class="toolbar">
  <div></div>
  <a class="btn btn-primary" href="/app/users/new">+ Add Staff Account</a>
</div>

<div class="card" style="padding:0;">
  <div style="overflow-x:auto;">
    <table class="data-table">
      <thead>
        <tr><th>Name</th><th>Username</th><th>Role</th><th>Unit</th><th>Status</th><th>Intern Ends</th><th></th></tr>
      </thead>
      <tbody>
        <% rows.forEach((r) => { %>
          <tr data-href="/app/users/<%= r.id %>/edit">
            <td><%= r.name %></td>
            <td><%= r.username %></td>
            <td><span class="badge badge-brand"><%= humanize(r.role) %></span></td>
            <td><% if (r.unit_name) { %><%= r.unit_name %><% } else { %><span class="text-muted">—</span><% } %></td>
            <td><span class="badge <%= r.active ? 'badge-green' : 'badge-slate' %>"><%= r.active ? 'Active' : 'Inactive' %></span></td>
            <td><% if (r.role === 'INTERN') { %><%= fmtDate(r.intern_ends_at) %><% } else { %><span class="text-muted">—</span><% } %></td>
            <td style="text-align:right;"><a class="btn btn-secondary btn-sm" href="/app/users/<%= r.id %>/edit">Edit</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
