<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Set a new password — ERRS Manager</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <h1>Set a new password</h1>
      <p class="sub">For security, this account needs its own password before continuing — this happens once, right after your account is created or reset.</p>
      <% if (error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>
      <form action="/account/password" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
          <label for="password">New Password</label>
          <input class="form-input" type="password" id="password" name="password" required autofocus minlength="10">
        </div>
        <div class="form-row">
          <label for="confirm">Confirm New Password</label>
          <input class="form-input" type="password" id="confirm" name="confirm" required minlength="10">
        </div>
        <div class="help" style="margin-bottom:14px;">At least 10 characters, mixing at least two of: lowercase, uppercase, numbers, symbols.</div>
        <button class="btn btn-primary" type="submit" style="width:100%; justify-content:center;">Set password &amp; continue</button>
      </form>
    </div>
  </div>
</body>
</html>
