<%
  const STATUSES = ['APPLICATION_RECEIVED', 'RESPONDED', 'AWAITING_PAYMENT', 'PAID', 'ISSUED', 'EXPIRED', 'REJECTED'];
  const statusBadge = (s) => {
    if (s === 'ISSUED') return 'badge-green';
    if (s === 'REJECTED' || s === 'EXPIRED') return 'badge-red';
    if (s === 'AWAITING_PAYMENT' || s === 'RESPONDED') return 'badge-amber';
    return 'badge-slate';
  };
  const humanize = (s) => String(s).replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';

  const withQuery = (params) => {
    const usp = new URLSearchParams();
    if (unitFilter) usp.set('unit', unitFilter);
    if (statusFilter) usp.set('status', statusFilter);
    if (typeFilter) usp.set('type', typeFilter);
    if (q) usp.set('q', q);
    Object.entries(params).forEach(([k, v]) => usp.set(k, v));
    return `/app/documents?${usp.toString()}`;
  };
  const exportUrl = () => {
    const usp = new URLSearchParams();
    if (unitFilter) usp.set('unit', unitFilter);
    if (statusFilter) usp.set('status', statusFilter);
    if (typeFilter) usp.set('type', typeFilter);
    if (q) usp.set('q', q);
    const qs = usp.toString();
    return `/app/documents/export.csv${qs ? '?' + qs : ''}`;
  };
%>

<div class="toolbar">
  <form method="GET" class="filters">
    <% if (isDeptHead) { %>
      <select name="unit" onchange="this.form.submit()">
        <option value="">All units</option>
        <% units.forEach((u) => { %>
          <option value="<%= u.id %>" <%= String(unitFilter) === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
        <% }) %>
      </select>
    <% } %>
    <select name="status" onchange="this.form.submit()">
      <option value="">All statuses</option>
      <% STATUSES.forEach((s) => { %>
        <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= humanize(s) %></option>
      <% }) %>
    </select>
    <select name="type" onchange="this.form.submit()">
      <option value="">All types</option>
      <% types.forEach((t) => { %>
        <option value="<%= t.id %>" <%= String(typeFilter) === String(t.id) ? 'selected' : '' %>><%= t.label %></option>
      <% }) %>
    </select>
    <input class="search-input" type="search" name="q" value="<%= q %>" placeholder="Search company, document #, reference…">
    <button class="btn btn-secondary btn-sm" type="submit">Search</button>
  </form>
  <div class="flex gap-2">
    <a class="btn btn-secondary" href="<%= exportUrl() %>">⬇ Export CSV</a>
    <a class="btn btn-primary" href="/app/documents/new">+ New Case</a>
  </div>
</div>

<div class="bulk-toolbar" id="bulk-toolbar" hidden>
  <span class="bulk-count" id="bulk-count"></span>
  <a class="btn btn-secondary btn-sm" id="bulk-export-link" href="<%= exportUrl() %>">⬇ Export selected</a>
  <% if (user.role !== 'INTERN') { %>
    <button class="btn btn-danger btn-sm" type="button" id="bulk-delete-btn">🗑 Delete selected</button>
  <% } %>
</div>
<form id="bulk-delete-form" action="/app/documents/bulk-delete" method="POST" style="display:none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<div class="card" style="padding:0;">
  <% if (!rows.length) { %>
    <div class="empty-state">
      <div class="icon">📄</div>
      No cases match these filters yet.
    </div>
  <% } else { %>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead>
          <tr>
            <th style="width:32px;"><input type="checkbox" class="bulk-select-all" aria-label="Select all"></th>
            <th>Type</th><th>Company</th><% if (isDeptHead) { %><th>Unit</th><% } %>
            <th>Status</th><th>Document #</th><th>Applied</th><th>Issued</th><th>Expiry</th><th>Files</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((r) => {
            const renewable = isRenewable(r) && !alreadyRenewedIds.has(r.id);
            const expired = r.expiry_date && new Date(r.expiry_date) < new Date();
            const att = attachmentCounts.get(r.id);
          %>
            <tr data-href="/app/documents/<%= r.id %>/edit">
              <td><input type="checkbox" class="bulk-row-check" value="<%= r.id %>"></td>
              <td><%= r.type_label %><% if (r.chemical_name) { %><br><span class="text-muted text-sm"><%= r.chemical_name %></span><% } %></td>
              <td><%= r.company_name %></td>
              <% if (isDeptHead) { %><td><%= r.unit_name %></td><% } %>
              <td><span class="badge <%= statusBadge(r.status) %>"><%= humanize(r.status) %></span></td>
              <td><%= r.document_number || '—' %></td>
              <td><%= fmtDate(r.application_date) %></td>
              <td><%= fmtDate(r.date_issued) %></td>
              <td><%= fmtDate(r.expiry_date) %><% if (renewable) { %><br><span class="badge badge-amber"><%= expired ? 'Expired' : 'Expires soon' %></span><% } %></td>
              <td>
                <% if (att) { %>
                  <span class="badge badge-slate" title="<%= att.filenames.join(', ') %>">📎 <%= att.count %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td style="white-space:nowrap; text-align:right;">
                <a class="btn btn-secondary btn-sm" href="/app/documents/<%= r.id %>/edit">Open</a>
                <% if (r.document_number) { %>
                  <a class="btn btn-secondary btn-sm" href="/app/documents/<%= r.id %>/print" target="_blank">Print</a>
                <% } %>
                <% if (!r.document_number && r.status !== 'REJECTED') { %>
                  <form action="/app/documents/<%= r.id %>/issue" method="POST" style="display:inline;" onsubmit="return confirm('Issue this document? A permanent document number will be allocated.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-primary btn-sm" type="submit">Issue</button>
                  </form>
                <% } %>
                <% if (renewable) { %>
                  <form action="/app/documents/<%= r.id %>/renew" method="POST" style="display:inline;" onsubmit="return confirm('Start a renewal for this case? A new application will be created, pre-filled from this one.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-secondary btn-sm" type="submit">↻ Renew</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (page > 1) { %><a href="<%= withQuery({ page: page - 1 }) %>">← Prev</a><% } else { %><span class="disabled">← Prev</span><% } %>
        <span class="page-info">Page <%= page %> of <%= totalPages %> · <%= total %> total</span>
        <% if (page < totalPages) { %><a href="<%= withQuery({ page: page + 1 }) %>">Next →</a><% } else { %><span class="disabled">Next →</span><% } %>
      </div>
    <% } %>
  <% } %>
</div>
